{
  "name": "fridge-recipe-api",
  "compatibility_date": "2026-08-01",
  "main": "src/worker.ts",
  "vars": {
    "COUPANG_SUB_ID": "tossfridge"
  },
  // 비밀값: GEMINI_FREE_KEYS(쉼표 구분, 무료 키만) · COUPANG_ACCESS_KEY · COUPANG_SECRET_KEY
  "ratelimits": [
    // IP당 60초에 30회. 통신사 공유 IP를 고려해 넉넉하게 잡았어요.
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
